TAVILY_API_KEY="Your Tavily Key"
GOOGLE_API_KEY="Your Gemini key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GROQ_API_KEY="Your Groq key"
GROQ_MODEL="openai/gpt-oss-20b"

# Supabase PostgreSQL persistence
# Replace this with your Supabase direct or pooler connection string.
SUPABASE_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Optional standard PostgreSQL name, accepted as an alternative to
# SUPABASE_DATABASE_URL.
DATABASE_URL=""

# Optional Supabase REST values (useful when Supabase client features are added).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional LangSmith tracing
LANGSMITH_API_KEY="Your LangSmith key"
LANGSMITH_PROJECT="ScholarAI"
